<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Research Desk</title>
<style>
  :root{
    --ink:#1C2B33;
    --jade:#2E7D6B;
    --jade-dark:#215A4D;
    --mist:#EEF3F1;
    --card:#FFFFFF;
    --amber:#B97E2F;
    --slate:#5C6F76;
    --line:#D8E2DE;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:var(--mist);
    color:var(--ink);
    min-height:100vh;
  }
  .wrap{max-width:1060px;margin:0 auto;padding:28px 20px 60px}
  header{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:6px}
  h1{
    font-family:Georgia,"Times New Roman",serif;
    font-weight:600;font-size:30px;letter-spacing:-0.5px;
  }
  h1 .dot{color:var(--jade)}
  .tagline{color:var(--slate);font-size:14px}
  .searchbar{
    display:flex;gap:10px;margin:22px 0 28px;
  }
  .searchbar input{
    flex:1;padding:14px 16px;font-size:16px;
    border:1.5px solid var(--line);border-radius:10px;background:var(--card);
    color:var(--ink);outline:none;transition:border-color .15s;
  }
  .searchbar input:focus{border-color:var(--jade)}
  .searchbar button{
    padding:14px 22px;font-size:15px;font-weight:600;
    background:var(--jade);color:#fff;border:none;border-radius:10px;cursor:pointer;
    transition:background .15s;white-space:nowrap;
  }
  .searchbar button:hover{background:var(--jade-dark)}
  .searchbar button:focus-visible{outline:3px solid var(--amber);outline-offset:2px}
  .searchbar button:disabled{background:var(--slate);cursor:wait}
  .cols{display:grid;grid-template-columns:1fr 300px;gap:24px;align-items:start}
  @media(max-width:800px){.cols{grid-template-columns:1fr}}
  .panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px}
  .panel h2{
    font-family:Georgia,serif;font-size:17px;font-weight:600;margin-bottom:14px;
    padding-bottom:10px;border-bottom:1px solid var(--line);
  }
  .status{color:var(--slate);font-size:14px;padding:8px 0;display:none}
  .status.on{display:block}
  .status .pulse{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--jade);
    margin-right:8px;animation:pulse 1.1s infinite}
  @keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}
  @media(prefers-reduced-motion:reduce){.status .pulse{animation:none}}
  .empty{color:var(--slate);font-size:14.5px;line-height:1.6;padding:6px 0}
  .stamp{
    display:inline-block;font-size:11.5px;font-weight:700;letter-spacing:.6px;
    color:var(--amber);border:1.5px solid var(--amber);border-radius:6px;
    padding:2px 9px;transform:rotate(-1.5deg);margin-bottom:10px;text-transform:uppercase;
  }
  .result .q{font-family:Georgia,serif;font-size:20px;margin-bottom:14px;line-height:1.35}
  .result h3{
    font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;
    color:var(--jade);margin:18px 0 7px;
  }
  .result p{font-size:15px;line-height:1.65;margin-bottom:10px;white-space:pre-wrap}
  .sources{list-style:none}
  .sources li{
    font-size:14px;line-height:1.5;padding:7px 0 7px 14px;
    border-left:2.5px solid var(--jade);margin-bottom:6px;
  }
  .sources a{color:var(--jade-dark);font-weight:600;text-decoration:none;word-break:break-word}
  .sources a:hover{text-decoration:underline}
  .saved{
    margin-top:18px;font-size:13px;color:var(--jade-dark);background:var(--mist);
    border-radius:8px;padding:9px 12px;display:none;
  }
  .saved.on{display:block}
  .hist-item{
    width:100%;text-align:left;background:none;border:none;cursor:pointer;
    padding:11px 8px;border-radius:8px;border-bottom:1px solid var(--line);
    font-family:inherit;color:var(--ink);
  }
  .hist-item:hover{background:var(--mist)}
  .hist-item:focus-visible{outline:2px solid var(--jade)}
  .hist-item .hq{font-size:13.5px;font-weight:600;line-height:1.4;margin-bottom:3px}
  .hist-item .hd{font-size:11.5px;color:var(--amber);font-weight:700;letter-spacing:.4px}
  .hist-actions{display:flex;gap:8px;margin-top:14px}
  .hist-actions button{
    flex:1;font-size:12.5px;font-weight:600;padding:8px;border-radius:8px;cursor:pointer;
    border:1.5px solid var(--line);background:var(--card);color:var(--slate);
  }
  .hist-actions button:hover{border-color:var(--slate)}
  .err{
    display:none;background:#FBEFEA;border:1px solid #E3B7A5;color:#7A3B22;
    border-radius:10px;padding:12px 14px;font-size:14px;line-height:1.5;margin-bottom:14px;
  }
  .err.on{display:block}
  .note{font-size:12px;color:var(--slate);margin-top:10px;line-height:1.5}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Research Desk<span class="dot">.</span></h1>
    <span class="tagline">Live web research with sources, saved to your log</span>
  </header>

  <div class="searchbar">
    <input id="q" type="text" placeholder="Ask a research question, e.g. current fall-prevention best practices in assisted living"
      aria-label="Research question" />
    <button id="go">Search the web</button>
  </div>

  <div class="cols">
    <main>
      <div class="err" id="err"></div>
      <div class="status" id="status"><span class="pulse"></span><span id="statusText">Searching the web…</span></div>
      <div class="panel" id="resultPanel">
        <div class="empty" id="emptyMsg">
          Type a question above and press <strong>Search the web</strong>. I'll run a live search,
          synthesize what I find in plain language, list the sources, and save the entry to your research log.
        </div>
        <div class="result" id="result" style="display:none">
          <span class="stamp" id="rDate"></span>
          <div class="q" id="rQ"></div>
          <h3>Short summary</h3>
          <p id="rSummary"></p>
          <h3>Detailed findings</h3>
          <p id="rFindings"></p>
          <h3>Sources</h3>
          <ul class="sources" id="rSources"></ul>
          <div class="saved" id="savedMsg">✓ Saved to your research log</div>
        </div>
      </div>
    </main>

    <aside class="panel">
      <h2>Research log</h2>
      <div id="histList"><div class="empty">No past searches yet. Your history will appear here and stay saved between visits.</div></div>
      <div class="hist-actions">
        <button id="copyLog">Copy log as text</button>
        <button id="clearLog">Clear log</button>
      </div>
      <p class="note">To export this log as a Word document, ask Claude in chat:
      “Export my research history as a Word document.”</p>
    </aside>
  </div>
</div>

<script>
const LOG_KEY = "research-log";
let log = [];
let memoryOnly = false; // fallback when persistent storage is unavailable (e.g. GitHub Pages)

const $ = id => document.getElementById(id);

async function loadLog(){
  try{
    const res = await window.storage.get(LOG_KEY);
    if(res && res.value) log = JSON.parse(res.value);
  }catch(e){
    if(typeof window.storage === "undefined") memoryOnly = true;
    log = log || [];
  }
  renderHistory();
}

async function saveLog(){
  if(memoryOnly || typeof window.storage === "undefined"){ memoryOnly = true; return; }
  try{ await window.storage.set(LOG_KEY, JSON.stringify(log)); }
  catch(e){ console.error("Save failed", e); }
}

function fmtDate(iso){
  const d = new Date(iso);
  return d.toLocaleDateString(undefined,{year:"numeric",month:"short",day:"numeric"});
}

function renderHistory(){
  const list = $("histList");
  if(!log.length){
    list.innerHTML = '<div class="empty">No past searches yet. Your history will appear here and stay saved between visits.</div>';
    return;
  }
  list.innerHTML = "";
  [...log].reverse().forEach(entry=>{
    const b = document.createElement("button");
    b.className = "hist-item";
    b.innerHTML = '<div class="hq"></div><div class="hd"></div>';
    b.querySelector(".hq").textContent = entry.question;
    b.querySelector(".hd").textContent = fmtDate(entry.date);
    b.addEventListener("click",()=>showResult(entry,false));
    list.appendChild(b);
  });
}

function showResult(entry, justSaved){
  $("emptyMsg").style.display = "none";
  $("result").style.display = "block";
  $("rDate").textContent = "Researched " + fmtDate(entry.date);
  $("rQ").textContent = entry.question;
  $("rSummary").textContent = entry.summary;
  $("rFindings").textContent = entry.findings;
  const ul = $("rSources"); ul.innerHTML = "";
  (entry.sources || []).forEach(s=>{
    const li = document.createElement("li");
    if(s.url){
      const a = document.createElement("a");
      a.href = s.url; a.target = "_blank"; a.rel = "noopener";
      a.textContent = s.title || s.url;
      li.appendChild(a);
    }else{
      li.textContent = s.title || "";
    }
    ul.appendChild(li);
  });
  $("savedMsg").className = justSaved ? "saved on" : "saved";
  if(justSaved && memoryOnly){
    $("savedMsg").textContent = "✓ Saved for this session (persistent memory works on the published Claude version)";
  } else if(justSaved){
    $("savedMsg").textContent = "✓ Saved to your research log";
  }
}

function setBusy(on, text){
  $("go").disabled = on;
  $("status").className = on ? "status on" : "status";
  if(text) $("statusText").textContent = text;
}

function showError(msg){
  const e = $("err");
  e.textContent = msg;
  e.className = "err on";
}

async function runSearch(){
  const question = $("q").value.trim();
  if(!question) return;
  $("err").className = "err";
  setBusy(true, "Searching the web and reading sources…");
  try{
    const response = await fetch("https://api.anthropic.com/v1/messages",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        model:"claude-sonnet-4-6",
        max_tokens:1000,
        messages:[{role:"user",content:
          "You are a research assistant for a college student who is also a special education teacher and owner of an assisted living business. " +
          "Use web search to research this question, drawing on multiple reliable, recent sources: \"" + question + "\"\n\n" +
          "Then respond with ONLY a valid JSON object, no markdown fences, no preamble, in exactly this shape: " +
          '{"summary":"2-3 sentence plain-language summary","findings":"one clear paragraph of detailed findings in simple language","sources":[{"title":"source name","url":"https://..."}]} ' +
          "Include 3-5 real sources with working URLs. Use simple, clear English."
        }],
        tools:[{type:"web_search_20250305",name:"web_search"}]
      })
    });
    const data = await response.json();
    if(data.error) throw new Error(data.error.message || "API error");
    setBusy(true, "Synthesizing findings…");
    const text = (data.content||[])
      .filter(b=>b.type==="text").map(b=>b.text||"").join("\n");
    let parsed;
    try{
      const clean = text.replace(/```json|```/g,"").trim();
      parsed = JSON.parse(clean.slice(clean.indexOf("{"), clean.lastIndexOf("}")+1));
    }catch(e){
      parsed = {summary:text.slice(0,300), findings:text, sources:[]};
    }
    const entry = {
      id: Date.now().toString(),
      question,
      summary: parsed.summary || "",
      findings: parsed.findings || "",
      sources: Array.isArray(parsed.sources) ? parsed.sources : [],
      date: new Date().toISOString()
    };
    log.push(entry);
    await saveLog();
    renderHistory();
    showResult(entry, true);
    $("q").value = "";
  }catch(e){
    showError("The search could not be completed: " + e.message +
      ". Live web search only works on the published Claude.ai version of this artifact. Check your connection and try again.");
  }finally{
    setBusy(false);
  }
}

$("go").addEventListener("click", runSearch);
$("q").addEventListener("keydown", e=>{ if(e.key==="Enter") runSearch(); });

$("clearLog").addEventListener("click", async ()=>{
  if(!confirm("Clear your entire research log? This cannot be undone.")) return;
  log = [];
  try{ await window.storage.delete(LOG_KEY); }catch(e){}
  renderHistory();
  $("result").style.display = "none";
  $("emptyMsg").style.display = "block";
});

$("copyLog").addEventListener("click", ()=>{
  if(!log.length){ alert("Your log is empty."); return; }
  const text = log.map(e=>
    "QUESTION: " + e.question + "\nDATE: " + fmtDate(e.date) +
    "\nSUMMARY: " + e.summary + "\nFINDINGS: " + e.findings +
    "\nSOURCES:\n" + (e.sources||[]).map(s=>"  - " + (s.title||"") + " " + (s.url||"")).join("\n")
  ).join("\n\n---\n\n");
  navigator.clipboard.writeText(text).then(
    ()=>alert("Research log copied. Paste it into chat and ask Claude to export it as a Word document."),
    ()=>alert("Copy failed — your browser blocked clipboard access.")
  );
});

loadLog();
</script>
</body>
</html>
